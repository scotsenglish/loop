rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Mỗi người dùng chỉ có thể đọc/ghi dữ liệu của chính mình.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
